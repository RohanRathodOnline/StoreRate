# =================================================================
# StoreRate — Production Docker Environment Template
# =================================================================
# Instructions:
# 1. Copy this file to .env in the project root:
#    cp .env.example .env
# 2. Replace all placeholder values below with strong, unique secrets.
# 3. DO NOT commit your .env file to version control.
# =================================================================

# --- Host Port & Network Binding ---
# Port exposed on the host for the web app (served by Nginx)
FRONTEND_PORT=80

# Port and IP for direct backend API access
# In production, keep BACKEND_BIND_IP=127.0.0.1 to avoid exposing the raw Express port publicly
BACKEND_PORT=5001
BACKEND_BIND_IP=127.0.0.1

# --- MySQL Database Configuration ---
# Internal Docker service name (leave as 'mysql')
DB_HOST=mysql
DB_PORT=3306
DB_NAME=storerate_db
DB_USER=storerate_user

# Set strong passwords for your production database
DB_PASSWORD=replace_with_a_strong_database_password_here
MYSQL_ROOT_PASSWORD=replace_with_a_strong_root_password_here

# --- Authentication & JWT Security ---
# Generate a secure 64-character hex key: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_64_char_secret_in_production
JWT_EXPIRES_IN=24h

# --- CORS & Domain Configuration ---
# Comma-separated list of allowed origins (e.g., https://yourdomain.com,https://api.yourdomain.com)
# Leave as '*' or include your domain for public web access
CORS_ORIGIN=*

# --- Initial Administrator Account ---
# Initial System Administrator account seeded on the first startup
ADMIN_EMAIL=admin@storerating.com
ADMIN_PASSWORD=replace_with_secure_admin_password_123!
